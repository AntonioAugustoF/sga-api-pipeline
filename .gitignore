.env

*.pyc

# Tool caches. Anchored to directory names on purpose: a bare *cache*
# pattern would also swallow a source file such as infra/cache.py, which
# would then silently never be committed.
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/

data/raw/
data/processed/

logs/

# Data dumps: may carry personal data (CPF, telefone, email).
# Versioned SQL lives under sql/ (schema) and dbt/ (models and tests).
*.sql
!sql/**/*.sql
!dbt/**/*.sql

# dbt build artifacts
target/
dbt_packages/
.user.yml
# Working notes, deliberately local. They carry unfiltered context about the
# warehouse and about work in progress, and a `git add -A` swept them into a
# commit once before this line existed.
CLAUDE.md
WORKLOG.md
